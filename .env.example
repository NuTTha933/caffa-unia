
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Caffa_Unia
DB_USER=postgres
DB_PASSWORD= 


SESSION_SECRET=
SESSION_MAX_AGE_MIN=120

COOKIE_SECURE=false


UPLOAD_DIR=storage/uploads
MAX_IMAGE_MB=2
MAX_SLIP_MB=3


SHOP_NAME=Caffa_Unia
SHOP_PROMPTPAY=0-0000-00000-00-0 (บัญชีตัวอย่าง)

LOGIN_MAX_FAILURES=8

# Render (render.yaml ตั้งค่าให้อัตโนมัติ)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DB_SSL=true
# DB_AUTO_SETUP=true
# TRUST_PROXY=true
# SHOW_DEMO_ACCOUNTS=true
