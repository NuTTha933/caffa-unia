# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ (ห้าม commit ไฟล์ .env)
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kernel_coffee
DB_USER=postgres
DB_PASSWORD=ใส่รหัสผ่าน_postgres_ของคุณ

# Session — สุ่มค่ายาว ๆ เช่น node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=เปลี่ยนเป็นข้อความสุ่มยาวอย่างน้อย32ตัวอักษร
SESSION_MAX_AGE_MIN=120
# ตั้งเป็น true เมื่อใช้งานผ่าน HTTPS
COOKIE_SECURE=false

# การอัปโหลดไฟล์
UPLOAD_DIR=storage/uploads
MAX_IMAGE_MB=2
MAX_SLIP_MB=3

# ข้อมูลร้าน (แสดงในหน้าแนบสลิป)
SHOP_NAME=Caffa_Unia
SHOP_PROMPTPAY=0-0000-00000-00-0 (บัญชีตัวอย่าง)

# จำนวนครั้งที่ใส่รหัสผ่านผิดได้ภายใน 10 นาที
LOGIN_MAX_FAILURES=8

# ---- ใช้ตอนขึ้นเว็บจริง (Render ตั้งให้อัตโนมัติจาก render.yaml) ----
# DATABASE_URL=postgresql://user:password@host:5432/dbname   (ถ้าตั้ง จะใช้แทน DB_* ด้านบน)
# DB_SSL=true                 # เมื่อต่อฐานข้อมูลภายนอกที่บังคับ SSL
# DB_AUTO_SETUP=true          # ฐานข้อมูลว่าง -> สร้างตาราง + ข้อมูลตัวอย่างตอนเริ่ม Server
# TRUST_PROXY=true            # อยู่หลัง Proxy/HTTPS ของผู้ให้บริการ
# SHOW_DEMO_ACCOUNTS=true     # แสดงกล่องบัญชีทดสอบในหน้าเข้าสู่ระบบแม้ NODE_ENV=production
