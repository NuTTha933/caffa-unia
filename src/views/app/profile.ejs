<header class="page-head">
  <h1>ข้อมูลของฉัน</h1>
  <p class="page-head__lead">ข้อมูลบัญชีแก้ไขได้โดยผู้ดูแลระบบ · รหัสผ่านเปลี่ยนเองได้ที่นี่</p>
</header>

<div class="split">
  <section class="panel" aria-labelledby="acc-title">
    <h2 id="acc-title"><%= profile.full_name %></h2>
    <dl class="kv">
      <dt>ชื่อผู้ใช้</dt><dd class="mono"><%= profile.username %></dd>
      <dt>บทบาท</dt><dd><%= profile.role_name %></dd>
      <dt>อีเมล</dt><dd><%= profile.email || '—' %></dd>
      <dt>เบอร์โทร</dt><dd><%= profile.phone || '—' %></dd>
      <dt>เข้าสู่ระบบล่าสุด</dt><dd><%= fmt.dateTime(profile.last_login_at) %></dd>
    </dl>
  </section>

  <section class="panel" aria-labelledby="pw-title">
    <h2 id="pw-title">เปลี่ยนรหัสผ่าน</h2>
    <form method="post" action="/app/profile/password" novalidate class="stack-sm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% [['current_password', 'รหัสผ่านปัจจุบัน', 'current-password'], ['new_password', 'รหัสผ่านใหม่', 'new-password'], ['new_password_confirm', 'ยืนยันรหัสผ่านใหม่', 'new-password']].forEach(([f, label, ac]) => { %>
        <div class="field">
          <label for="<%= f %>"><%= label %></label>
          <input type="password" id="<%= f %>" name="<%= f %>" autocomplete="<%= ac %>" maxlength="72" class="input"
                 aria-describedby="<%= f %>-msg" <%- h.err(errors, f) ? 'aria-invalid="true"' : '' %>>
          <p class="field__error" id="<%= f %>-msg"><%= h.err(errors, f) %></p>
        </div>
      <% }) %>
      <p class="field__help">อย่างน้อย 8 ตัวอักษร มีทั้งตัวอักษรและตัวเลข · ระบบเก็บเป็น bcrypt hash เท่านั้น</p>
      <button class="btn btn--primary">เปลี่ยนรหัสผ่าน</button>
    </form>
  </section>
</div>
