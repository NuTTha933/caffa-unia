<%
  const cols = [
    { key: 'accepted', title: 'รอชง', rows: q.accepted, empty: 'ไม่มีออเดอร์รอชง' },
    { key: 'brewing', title: 'กำลังชง', rows: q.brewing, empty: 'ยังไม่มีแก้วที่กำลังชง' },
    { key: 'ready', title: 'พร้อมรับ', rows: q.ready, empty: 'ไม่มีแก้วรอลูกค้ารับ' },
  ];
%>
<header class="page-head">
  <h1>คิวบาร์</h1>
  <p class="page-head__lead">เฉพาะออเดอร์ที่ร้านตรวจสลิปแล้ว เรียงตามเวลาที่รับออเดอร์</p>
  <div class="page-head__actions"><a class="btn" href="/app/queue">รีเฟรช</a></div>
</header>

<div class="bar">
  <% cols.forEach(c => { %>
    <section class="bar__col" aria-labelledby="col-<%= c.key %>">
      <h2 id="col-<%= c.key %>"><%= c.title %> <span class="count"><%= c.rows.length %></span></h2>
      <% if (!c.rows.length) { %><p class="bar__empty"><%= c.empty %></p><% } %>
      <ol class="bar__list">
        <% c.rows.forEach(o => { %>
          <li class="ticket<%= o.status === 'ready' ? ' is-ready' : '' %>">
            <div class="ticket__head">
              <a class="ticket__no" href="/app/orders/<%= o.id %>"><%= fmt.orderNo(o.id) %></a>
              <span class="ticket__age"><%= fmt.ago(o.status === 'ready' ? o.ready_at : o.status === 'brewing' ? o.brewing_at : o.reviewed_at) %></span>
            </div>
            <p class="ticket__who"><%= o.customer_name %><%= o.barista_name && o.status !== 'accepted' ? ` · ชงโดย ${o.barista_name}` : '' %></p>
            <ul class="ticket__items">
              <% o.items.forEach(i => { %>
                <li><span class="q">×<%= i.quantity %></span><span><%= i.item_name %></span></li>
              <% }) %>
            </ul>
            <% if (o.note) { %><p class="ticket__note">หมายเหตุ: <%= o.note %></p><% } %>
            <% if (o.actions.brew) { %>
              <form method="post" action="/app/orders/<%= o.id %>/brew"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="queue"><button class="btn btn--primary btn--block">เริ่มชง</button></form>
            <% } else if (o.actions.ready) { %>
              <form method="post" action="/app/orders/<%= o.id %>/ready"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="queue"><button class="btn btn--primary btn--block">ชงเสร็จ</button></form>
            <% } else if (o.actions.complete) { %>
              <form method="post" action="/app/orders/<%= o.id %>/complete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="back" value="queue"><button class="btn btn--block">ส่งมอบแล้ว</button></form>
            <% } %>
          </li>
        <% }) %>
      </ol>
    </section>
  <% }) %>
</div>

<section class="section" aria-labelledby="done-title">
  <div class="section__head"><h2 id="done-title">ส่งมอบแล้ววันนี้</h2><span class="small"><%= q.done.length %> ล่าสุด</span></div>
  <% if (q.done.length) { %>
    <p class="done-strip"><% q.done.forEach(o => { %><a class="order-no" href="/app/orders/<%= o.id %>"><%= fmt.orderNo(o.id) %></a> <span><%= fmt.time(o.completed_at) %></span><% }) %></p>
  <% } else { %><p class="muted small">ยังไม่มีออเดอร์ที่ส่งมอบวันนี้</p><% } %>
</section>
