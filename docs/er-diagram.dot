    "permissions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#9fb3ae"><tr><td colspan="3" bgcolor="#372721"><font color="white"><b>permissions</b></font></td></tr><tr><td align="left" port="id_l"><b>id</b></td><td align="left"><font color="#5b6b68">int NN</font></td><td align="left" port="id_r"><font color="#372721"><b>PK</b></font></td></tr><tr><td align="left" port="code_l">code</td><td align="left"><font color="#5b6b68">varchar(100) NN</font></td><td align="left" port="code_r"><font color="#372721"><b>UK</b></font></td></tr><tr><td align="left" port="name_l">name</td><td align="left"><font color="#5b6b68">varchar(150) NN</font></td><td align="left" port="name_r"> </td></tr><tr><td align="left" port="description_l">description</td><td align="left"><font color="#5b6b68">text</font></td><td align="left" port="description_r"> </td></tr><tr><td align="left" port="created_at_l">created_at</td><td align="left"><font color="#5b6b68">timestamptz NN</font></td><td align="left" port="created_at_r"> </td></tr><tr><td align="left" port="updated_at_l">updated_at</td><td align="left"><font color="#5b6b68">timestamptz NN</font></td><td align="left" port="updated_at_r"> </td></tr></table>>];
