    "app_functions" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#9fb3ae"><tr><td colspan="3" bgcolor="#372721"><font color="white"><b>app_functions</b></font></td></tr><tr><td align="left" port="id_l"><b>id</b></td><td align="left"><font color="#5b6b68">int NN</font></td><td align="left" port="id_r"><font color="#372721"><b>PK</b></font></td></tr><tr><td align="left" port="code_l">code</td><td align="left"><font color="#5b6b68">varchar(100) NN</font></td><td align="left" port="code_r"><font color="#372721"><b>UK</b></font></td></tr><tr><td align="left" port="name_l">name</td><td align="left"><font color="#5b6b68">varchar(150) NN</font></td><td align="left" port="name_r"> </td></tr><tr><td align="left" port="module_l">module</td><td align="left"><font color="#5b6b68">varchar(50) NN</font></td><td align="left" port="module_r"> </td></tr><tr><td align="left" port="description_l">description</td><td align="left"><font color="#5b6b68">text</font></td><td align="left" port="description_r"> </td></tr><tr><td align="left" port="endpoints_l">endpoints</td><td align="left"><font color="#5b6b68">text</font></td><td align="left" port="endpoints_r"> </td></tr><tr><td align="left" port="sort_order_l">sort_order</td><td align="left"><font color="#5b6b68">int NN</font></td><td align="left" port="sort_order_r"> </td></tr></table>>];
