digraph ER {
  graph [rankdir=LR, splines=spline, nodesep=0.5, ranksep=1.1, fontname="Loma, IBM Plex Sans Thai, Sarabun, sans-serif", fontsize=16, pad=0.4, bgcolor="white", labelloc=b, labeljust=l, label="ER Diagram ระบบจัดการร้านกาแฟ Kernel Coffee (สร้างจากฐานข้อมูลจริง)  |  เส้นทึบ = FK บังคับ (1 : N)  |  เส้นประ = FK ว่างได้ (0..1 : N)  |  NN = NOT NULL, PK/FK/UK = คีย์"];
  node [shape=plain, fontname="Loma, IBM Plex Sans Thai, Sarabun, sans-serif", fontsize=11];
  edge [fontname="Loma, IBM Plex Sans Thai, Sarabun, sans-serif", fontsize=9, color="#46625d", dir=both];
  subgraph cluster_0 {
    label="Authentication & ACL (ผู้ใช้ บทบาท สิทธิ์)"; labelloc=t; style="rounded,dashed"; color="#372721"; fontcolor="#372721";
    "users" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#9fb3ae"><tr><td colspan="3" bgcolor="#372721"><font color="white"><b>users</b></font></td></tr><tr><td align="left" port="id_l"><b>id</b></td><td align="left"><font color="#5b6b68">int NN</font></td><td align="left" port="id_r"><font color="#372721"><b>PK</b></font></td></tr><tr><td align="left" port="username_l">username</td><td align="left"><font color="#5b6b68">varchar(50) NN</font></td><td align="left" port="username_r"><font color="#372721"><b>UK</b></font></td></tr><tr><td align="left" port="full_name_l">full_name</td><td align="left"><font color="#5b6b68">varchar(150) NN</font></td><td align="left" port="full_name_r"> </td></tr><tr><td align="left" port="email_l">email</td><td align="left"><font color="#5b6b68">varchar(150)</font></td><td align="left" port="email_r"><font color="#372721"><b>UK</b></font></td></tr><tr><td align="left" port="phone_l">phone</td><td align="left"><font color="#5b6b68">varchar(20)</font></td><td align="left" port="phone_r"> </td></tr><tr><td align="left" port="password_hash_l">password_hash</td><td align="left"><font color="#5b6b68">varchar(255) NN</font></td><td align="left" port="password_hash_r"> </td></tr><tr><td align="left" port="role_id_l">role_id</td><td align="left"><font color="#5b6b68">int NN</font></td><td align="left" port="role_id_r"><font color="#372721"><b>FK</b></font></td></tr><tr><td align="left" port="is_active_l">is_active</td><td align="left"><font color="#5b6b68">bool NN</font></td><td align="left" port="is_active_r"> </td></tr><tr><td align="left" port="last_login_at_l">last_login_at</td><td align="left"><font color="#5b6b68">timestamptz</font></td><td align="left" port="last_login_at_r"> </td></tr><tr><td align="left" port="created_at_l">created_at</td><td align="left"><font color="#5b6b68">timestamptz NN</font></td><td align="left" port="created_at_r"> </td></tr><tr><td align="left" port="updated_at_l">updated_at</td><td align="left"><font color="#5b6b68">timestamptz NN</font></td><td align="left" port="updated_at_r"> </td></tr></table>>];
    "roles" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4" color="#9fb3ae"><tr><td colspan="3" bgcolor="#372721"><font color="white"><b>roles</b></font></td></tr><tr><td align="left" port="id_l"><b>id</b></td><td align="left"><font color="#5b6b68">int NN</font></td><td align="left" port="id_r"><font color="#372721"><b>PK</b></font></td></tr><tr><td align="left" port="code_l">code</td><td align="left"><font color="#5b6b68">varchar(50) NN</font></td><td align="left" port="code_r"><font color="#372721"><b>UK</b></font></td></tr><tr><td align="left" port="name_l">name</td><td align="left"><font color="#5b6b68">varchar(100) NN</font></td><td align="left" port="name_r"> </td></tr><tr><td align="left" port="description_l">description</td><td align="left"><font color="#5b6b68">text</font></td><td align="left" port="description_r"> </td></tr><tr><td align="left" port="is_admin_l">is_admin</td><td align="left"><font color="#5b6b68">bool NN</font></td><td align="left" port="is_admin_r"> </td></tr><tr><td align="left" port="is_system_l">is_system</td><td align="left"><font color="#5b6b68">bool NN</font></td><td align="left" port="is_system_r"> </td></tr><tr><td align="left" port="created_at_l">created_at</td><td align="left"><font color="#5b6b68">timestamptz NN</font></td><td align="left" port="created_at_r"> </td></tr><tr><td align="left" port="updated_at_l">updated_at</td><td align="left"><font color="#5b6b68">timestamptz NN</font></td><td align="left" port="updated_at_r"> </td></tr></table>>];
