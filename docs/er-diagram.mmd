erDiagram
  permissions ||--o{ permission_functions : "permission_id"
  app_functions ||--o{ permission_functions : "function_id"
  roles ||--o{ users : "role_id"
  roles ||--o{ role_permissions : "role_id"
  permissions ||--o{ role_permissions : "permission_id"
  users |o--o{ role_permissions : "granted_by"
  menu_categories ||--o{ menu_items : "category_id"
  users |o--o{ menu_items : "created_by"
  users ||--o{ orders : "customer_id"
  users |o--o{ orders : "reviewed_by, barista_id"
  orders ||--o{ order_items : "order_id"
  menu_items ||--o{ order_items : "menu_item_id"
  orders ||--o{ order_status_history : "order_id"
  users |o--o{ order_status_history : "changed_by"
  menu_items |o--o{ files : "menu_item_id"
  orders |o--o{ files : "order_id"
  users |o--o{ files : "uploaded_by"
  users |o--o{ audit_logs : "user_id"
  app_functions {
    int id PK
    varchar_100 code UK
    varchar_150 name
    varchar_50 module
    text description
    text endpoints
    int sort_order
  }
  audit_logs {
    bigint id PK
    timestamptz created_at
    int user_id FK
    varchar_100 username
    varchar_50 role_code
    varchar_30 category
    varchar_60 action
    varchar_50 resource_type
    varchar_64 resource_id
    varchar_20 result
    varchar_10 method
    varchar_255 path
    varchar_64 ip
    varchar_255 user_agent
    jsonb details
  }
  files {
    uuid id PK
    varchar_20 kind
    varchar_255 original_name
    varchar_100 stored_name UK
    varchar_100 mime_type
    int size_bytes
    int menu_item_id FK
    int order_id FK
    int uploaded_by FK
    timestamptz uploaded_at
  }
  menu_categories {
    int id PK
    varchar_80 name UK
    int sort_order
  }
  menu_items {
    int id PK
    varchar_20 code UK
    varchar_120 name
    int category_id FK
    text description
    numeric price
    bool is_available
    int created_by FK
    timestamptz created_at
    timestamptz updated_at
  }
  order_items {
    int id PK
    int order_id FK
    int menu_item_id FK
    varchar_120 item_name
    numeric unit_price
    int quantity
    numeric line_total
  }
  order_status_history {
    int id PK
    int order_id FK
    varchar_20 from_status
    varchar_20 to_status
    int changed_by FK
    text note
    timestamptz changed_at
  }
  orders {
    int id PK
    int customer_id FK
    varchar_20 status
    numeric total_amount
    text note
    int reviewed_by FK
    timestamptz reviewed_at
    text review_note
    int barista_id FK
    timestamptz brewing_at
    timestamptz ready_at
    timestamptz completed_at
    timestamptz created_at
    timestamptz updated_at
  }
  permission_functions {
    int permission_id FK, PK
    int function_id FK, PK
  }
  permissions {
    int id PK
    varchar_100 code UK
    varchar_150 name
    text description
    timestamptz created_at
    timestamptz updated_at
  }
  role_permissions {
    int role_id FK, PK
    int permission_id FK, PK
    int granted_by FK
    timestamptz granted_at
  }
  roles {
    int id PK
    varchar_50 code UK
    varchar_100 name
    text description
    bool is_admin
    bool is_system
    timestamptz created_at
    timestamptz updated_at
  }
  user_sessions {
    varchar sid PK
    json sess
    timestamp expire
  }
  users {
    int id PK
    varchar_50 username UK
    varchar_150 full_name
    varchar_150 email UK
    varchar_20 phone
    varchar_255 password_hash
    int role_id FK
    bool is_active
    timestamptz last_login_at
    timestamptz created_at
    timestamptz updated_at
  }
